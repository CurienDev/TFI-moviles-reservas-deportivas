{
  "expo": {
    "name": "Reservas Deportivas",
    "slug": "reservas-deportivas",
    "scheme": "reservasdeportivas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ar.gob.villaguay.reservasdeportivas"
    },
    "android": {
      "package": "ar.gob.villaguay.reservasdeportivas",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#4B3F9E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#F4F5F9",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0C12"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "La cámara se usa para escanear el código QR de las reservas en la puerta.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Se usa para subir fotos del estado de las canchas.",
          "microphonePermission": false,
          "cameraPermission": "La cámara se usa para escanear el código QR de las reservas en la puerta."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tu ubicación se usa solo para el mapa y para saber qué complejo te queda más cerca.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4B3F9E"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Se usa para que el encargado confirme su identidad antes de escanear."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-video",
      "expo-image",
      "expo-font",
      "@maplibre/maplibre-react-native",
      "@react-native-vector-icons/ionicons",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}